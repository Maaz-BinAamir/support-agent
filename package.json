{
  "name": "support-agent",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "retrieval:dev": "uv --cache-dir .uv-cache --directory services/retrieval run python -c \"from app.main import run; run()\"",
    "retrieval:ingest": "uv --cache-dir .uv-cache --directory services/retrieval run python -c \"from app.ingest import main; main()\"",
    "preview": "vite preview",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/kit": "^2.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@types/node": "^24.3.0",
    "prettier": "^3.6.2",
    "prettier-plugin-svelte": "^3.4.0",
    "svelte": "^5.56.1",
    "svelte-check": "^4.6.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16"
  },
  "dependencies": {
    "ai": "^5.0.248",
    "@ai-sdk/groq": "^2.0.51",
    "zod": "^4.4.3"
  }
}
